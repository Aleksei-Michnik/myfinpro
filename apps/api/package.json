    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-mariadb": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.76.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^4.9.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.2",
    "mariadb": "^3.5.2",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
